# ===== 飞书凭据（开放平台 → 凭证与基础信息）=====
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# ===== agent 模式（发消息遥控本机；留空则走下面聊天模式）=====
# {file} 占位 = 消息内容的临时文件路径
AGENT_CMD=claude -p --dangerously-skip-permissions --output-format text < "{file}"
# agent 工作目录（指令在这下面执行）
WORK_DIR=E:\VSCodeSpace\Agent
# 任务超时（分钟，默认 15）
# TASK_TIMEOUT_MIN=15
# 管理员 open_id（留空 = 第一个私聊机器人的用户自动锁定为管理员）
# ADMIN_OPEN_ID=

# ===== 聊天模式（AGENT_CMD 为空时生效：调 LLM 网关纯聊天）=====
GATEWAY_URL=http://127.0.0.1:3011/v1/chat/completions
GATEWAY_KEY=sk-xxxx
BOT_MODEL=glm-5.3-flash
# MAX_HISTORY=12
